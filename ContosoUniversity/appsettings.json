{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:${AZURE_SQL_SERVER}.database.windows.net;Database=${AZURE_SQL_DATABASE};Authentication=Active Directory Default;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NotificationQueue": {
    "ServiceBusNamespace": "${AZURE_SERVICE_BUS_NAMESPACE}.servicebus.windows.net",
    "QueueName": "notifications"
  },
  "ApplicationInsights": {
    "ConnectionString": "${APPLICATIONINSIGHTS_CONNECTION_STRING}"
  }
}
