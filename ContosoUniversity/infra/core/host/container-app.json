        "description": "Maximum replicas"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-identity', parameters('name'))]",
      "location": "[parameters('location')]",
      "tags": "[if(contains(parameters('tags'), 'azd-service-name'), createObject('azd-env-name', parameters('tags')['azd-env-name']), parameters('tags'))]"
    },
    {
      "condition": "[not(empty(parameters('containerRegistryName')))]",
      "type": "Microsoft.Authorization/roleAssignments",
